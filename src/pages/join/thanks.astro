---
import Base from '../../layouts/Base.astro';
---
<Base title="You are on the list" description="Confirmation that your email address was added to the Dice & Tale game day announcements.">
  <section>
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Confirmed</p>
      <h1>You are on the list</h1>
      <p class="lede">
        You will get one email when the next game day has a date and a venue.
      </p>
      <p>
        In the meantime the <a href="/game-days">table list for the next one</a> is already
        up, and the Discord is where dates leak first.
      </p>
      <p><a class="btn" href="/game-days">See the next game day</a></p>
    </div>
  </section>
</Base>

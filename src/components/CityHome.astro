---
/* The home page of a live city. Rendered at "/" for the primary city and at
   "/<city>" for every other live one, so adding a city adds a page rather than
   a rewrite. Everything below is filtered by the city passed in. */
import { getCollection } from 'astro:content';
import Photo from './Photo.astro';
import SessionTable from './SessionTable.astro';

interface Props {
  citySlug: string;
  cityName: string;
  since?: string;
}
const { citySlug, cityName, since = '2024' } = Astro.props;

const cityOf = (s: string) => s.trim().toLowerCase();

const days = (await getCollection('gamedays'))
  .filter(d => cityOf(d.data.city) === citySlug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const next = days.find(d => d.data.status !== 'past') ?? days[0];
const past = days.filter(d => d.data.status === 'past').slice(0, 3);

const photos = (await getCollection('photos')).filter(p => cityOf(p.data.city) === citySlug);
/* A city that has just gone live may have a date before it has any photographs.
   The hero degrades to type on the brand ground rather than blocking the build. */
const heroPhoto = photos.filter(p => p.data.hero).sort((a, b) => a.data.order - b.data.order)[0];
const bandPhotos = photos
  .filter(p => p.data.slug !== heroPhoto?.data.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

/* The portrait beside the story: the second-best photo this city has. */
const storyPhoto = photos
  .filter(p => p.data.slug !== heroPhoto?.data.slug && !bandPhotos.some(b => b.data.slug === p.data.slug))
  .sort((a, b) => a.data.order - b.data.order)[0];

const gmCount = new Set(days.flatMap(d => d.data.sessions.map(s => s.gm))).size;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

const totalTables = next?.data.sessions.length ?? 0;
const openTables = next?.data.sessions.filter(s => !s.full).length ?? 0;
const waitlisted = next?.data.sessions.filter(s => s.waitlist).length ?? 0;
const beginnerTables = next?.data.sessions.filter(s =>
  s.tags.some(t => /beginner/i.test(t)) || /beginner/i.test(s.level ?? '')
).length ?? 0;
const systems = new Set(next?.data.sessions.map(s => s.system).filter(Boolean) ?? []);
const venues = [...new Set(days.map(d => d.data.venue))];

const promises = [
  {
    h: 'Icebreaker first',
    p: 'You meet players and game masters at the table, not in a Discord thread three weeks earlier. No awkward cold start, no group you have to audition for.',
  },
  {
    h: 'Booking takes a minute',
    p: `Pick a table, put your name on a seat. ${totalTables} tables next time, ${openTables} with seats free and ${waitlisted} running a waiting list.`,
  },
  {
    h: 'Zero gatekeeping',
    p: `${beginnerTables} of the ${totalTables} tables next time provide the character, the dice and the rules. Never having played is the normal way to arrive.`,
  },
  {
    h: 'Every table labelled',
    p: 'Seat count, system, how long it runs, whether it suits a first-timer, and what it contains. Published before you book, not sprung on you at the table.',
  },
  {
    h: 'Safety tools as standard',
    p: 'Lines and veils at every table. Any player can stop a scene at any moment and nobody asks why. It takes three minutes at the start and it is not exceptional.',
  },
  {
    h: `${cityName} roots`,
    p: `Real rooms in real places — ${venues.join(', ')} — for an afternoon and an evening, once a month.`,
  },
];
---
<!-- ================= hero ================= -->
<section class:list={['hero', 'bleed', !heroPhoto && 'hero--plain']}>
  {heroPhoto && <Photo slug={heroPhoto.data.slug} sizes="100vw" ratio="16/9" priority class="hero-img" />}
  {heroPhoto && <div class="hero-veil"></div>}
  <div class:list={['hero-text', !heroPhoto && 'hero-text--plain']}>
    <div class="wrap">
      <p class="hero-kicker">
        {cityName} &middot; tabletop roleplaying{since && <> since {since}</>}
      </p>
      <h1>Roll for<br />Adventure</h1>
      <p class="hero-line">
        A community where adventurers meet before they play. Break the ice,
        find your party, and belong.
      </p>
    </div>
  </div>
</section>

{next && (
  <div class="wrap">
    <div class="playbill">
      <div class="pb-date">
        <span class="pb-month">{next.data.date.toLocaleDateString('en-GB', { month: 'short' }).toUpperCase()}</span>
        <span class="pb-day">{next.data.date.getDate()}</span>
        <span class="pb-weekday">{next.data.date.toLocaleDateString('en-GB', { weekday: 'short' })}</span>
      </div>
      <div class="pb-body">
        <p class="pb-eyebrow mono">Next game day in {cityName}</p>
        <h2>{next.data.venue}</h2>
        <dl class="pb-facts">
          <div><dt>Where</dt><dd>{next.data.address}</dd></div>
          <div><dt>When</dt><dd class="mono">{next.data.startTime} &ndash; {next.data.endTime}</dd></div>
          <div><dt>Entry</dt><dd>{next.data.entry}</dd></div>
          <div><dt>Tables</dt><dd>{totalTables} across three time slots &middot; {[...systems].length} systems</dd></div>
        </dl>
        <div class="pb-actions">
          {next.data.bookUrl && <a class="btn" href={next.data.bookUrl} rel="noopener">Reserve a seat</a>}
          <a class="btn btn--quiet" href={`/game-days/${next.id}`}>Read the {totalTables} tables</a>
        </div>
        {next.data.spotsLeft != null && next.data.capacity != null && (
          <p class="pb-scarcity mono">
            {next.data.spotsLeft} of {next.data.capacity} places left at the door
          </p>
        )}
      </div>
    </div>
  </div>
)}

<section>
  <div class="wrap">
    <div class="promise-head">
      <h2>Not your average TTRPG community</h2>
      <p class="lede">Six things that are true of every game day, not six things we intend.</p>
    </div>
    <ul class="promises">
      {promises.map((p, i) => (
        <li>
          <span class="p-n mono">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<hr class="rule--double" />

<section class="why">
  <div class="wrap why-grid">
    <div class="why-text">
      <p class="eyebrow">Why this exists</p>
      <h2>The real quest isn't finding a game</h2>
      <p class="big">
        After years of running games across Europe I noticed something simple but
        true: finding the right group is harder than playing the game itself.
        Schedules clash, vibes miss, and the magic fades before the first dice
        even roll.
      </p>
      <p>
        So Dice &amp; Tale is built the other way round. The gatherings are not
        about min-maxing or rushing a campaign. They are afternoons where people
        connect first and play second, because when the chemistry is real the
        story writes itself.
      </p>
      <p>
        Nobody is paid. {gmCount} volunteer game masters run the tables, entry
        covers the room, and whatever is left goes into the next one.
      </p>
      <p class="sig">
        <span class="sig-name">Erik Roa</span>
        <span class="sig-role mono">Organiser</span>
      </p>
    </div>
    {storyPhoto && (
      <div class="why-media">
        <Photo slug={storyPhoto.data.slug} sizes="(max-width: 900px) 100vw, 40vw" ratio="4/5" />
      </div>
    )}
  </div>
</section>

{bandPhotos.length === 3 && (
  <div class="band bleed">
    {bandPhotos.map(p => (
      <Photo slug={p.data.slug} sizes="(max-width: 760px) 78vw, 33vw" ratio="3/2" />
    ))}
  </div>
)}

{next && next.data.sessions.length > 0 && (
  <section>
    <div class="wrap">
      <div class="section-head">
        <h2>The tables on {fmt(next.data.date)}</h2>
        {next.data.scheduleUrl && (
          <a class="head-link mono" href={next.data.scheduleUrl} rel="noopener">Live seat counts &rarr;</a>
        )}
      </div>
      <SessionTable sessions={next.data.sessions} />
      <p class="note">
        Seat counts move. These were right when the page was built; the booking
        page always has the live figure.
      </p>
    </div>
  </section>
)}

<hr class="rule--double" />

<section class="archive-sec">
  <div class="wrap">
    <div class="section-head">
      <h2>Previously in {cityName}</h2>
      <a class="head-link mono" href="/game-days">All game days &rarr;</a>
    </div>
    <ul class="archive">
      {past.map(d => (
        <li>
          <a href={`/game-days/${d.id}`}>
            <span class="ar-date mono">{d.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
            <span class="ar-title">{d.data.title}</span>
            <span class="ar-venue">{d.data.venue}</span>
            <span class="ar-count mono">{d.data.sessions.length > 0 ? `${d.data.sessions.length} tables` : '—'}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; padding: 0; }
  /* No photograph yet: the same type on the brand violet, so a new city still
     has a real front page on day one. */
  .hero--plain { background: #1A0733; padding: clamp(4rem, 12vh, 7rem) 0 clamp(3rem, 9vh, 5rem); }
  .hero-text--plain { position: static; }
  .hero :global(.hero-img) {
    height: clamp(400px, 66vh, 660px);
    width: 100%;
    aspect-ratio: auto !important;
  }
  .hero :global(.hero-img img) { object-position: center 40%; }
  .hero-veil {
    position: absolute; inset: 0;
    background: linear-gradient(to top,
      rgba(26,7,51,.95) 0%, rgba(26,7,51,.87) 30%, rgba(26,7,51,.62) 56%,
      rgba(26,7,51,.28) 80%, rgba(26,7,51,.42) 100%);
  }
  .hero-text { position: absolute; left: 0; right: 0; bottom: clamp(4.5rem, 11vh, 7rem); }
  .hero-kicker {
    font-family: "JetBrains Mono", monospace; font-size: 0.68rem;
    letter-spacing: 0.24em; text-transform: uppercase;
    color: #EDCF64; margin: 0 0 0.8rem;
  }
  .hero h1 {
    color: #FBF8F3; text-transform: uppercase; letter-spacing: 0.05em;
    font-size: clamp(2.1rem, 7vw, 4.3rem); margin: 0; line-height: 1.04;
    text-shadow: 0 2px 24px rgba(26,7,51,.5);
  }
  .hero-line {
    color: #EFE7DA; font-size: clamp(1rem, 2.1vw, 1.22rem);
    max-width: 44ch; margin: 1rem 0 0; font-style: italic;
  }

  .playbill {
    position: relative; z-index: 2;
    margin-top: clamp(-3.5rem, -5vw, -2rem);
    display: grid; grid-template-columns: 7.5rem 1fr;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-top: 4px solid var(--gold);
    box-shadow: 0 18px 44px -28px rgba(26, 7, 51, 0.55);
  }
  .pb-date {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 1.6rem 1rem; border-right: 1px solid var(--rule); background: var(--paper-2);
  }
  .pb-month {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem; letter-spacing: 0.2em; color: var(--gold);
  }
  .pb-day {
    font-family: "Cinzel", Georgia, serif; font-size: 3.1rem; font-weight: 700;
    line-height: 1; color: var(--ink); margin: 0.1rem 0;
  }
  .pb-weekday {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute);
  }
  .pb-body { padding: 1.6rem 1.9rem 1.8rem; }
  .pb-eyebrow {
    font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--gold); margin: 0 0 0.5rem;
  }
  .pb-body h2 { margin-bottom: 1.1rem; }
  .pb-facts { margin: 0 0 1.5rem; display: grid; gap: 0.55rem; }
  .pb-facts > div { display: grid; grid-template-columns: 5.2rem 1fr; gap: 0.9rem; align-items: baseline; }
  .pb-facts dt {
    font-family: "JetBrains Mono", monospace; font-size: 0.64rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute);
  }
  .pb-facts dd { margin: 0; font-size: 0.98rem; }
  .pb-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .pb-scarcity { margin: 1.1rem 0 0; font-size: 0.78rem; letter-spacing: 0.08em; color: var(--flag); }

  .promise-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .promise-head h2 { margin-bottom: 0.7rem; }
  .promises {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: clamp(1.6rem, 3.5vw, 2.6rem) clamp(2rem, 4vw, 3.2rem);
  }
  .promises li { margin: 0; display: grid; grid-template-columns: 2.6rem 1fr; gap: 0 1rem; }
  .p-n {
    font-size: 0.95rem; color: var(--gold);
    padding-top: 0.5rem; border-top: 2px solid var(--gold); align-self: start;
  }
  .promises h3 { margin-bottom: 0.5rem; letter-spacing: 0.03em; }
  .promises p { font-size: 0.98rem; color: var(--ink-soft); margin: 0; }

  .why-grid {
    display: grid; grid-template-columns: 1fr 0.62fr;
    gap: clamp(2rem, 5vw, 4rem); align-items: center;
  }
  .why-text h2 { margin-bottom: 1.1rem; }
  .big { font-size: 1.14rem; }
  .why-media :global(.photo) { border: 1px solid var(--rule); }
  .sig {
    margin-top: 1.8rem; padding-top: 1rem; border-top: 1px solid var(--rule);
    display: flex; gap: 0.9rem; align-items: baseline; max-width: none;
  }
  .sig-name { font-family: "Cinzel", Georgia, serif; font-size: 1.1rem; letter-spacing: 0.04em; }
  .sig-role { font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-mute); }

  .band {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px;
    background: var(--rule); border-block: 1px solid var(--rule);
  }

  .head-link {
    font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--gold);
  }
  .note { font-size: 0.88rem; color: var(--ink-mute); font-style: italic; margin-top: 1.5rem; }

  .archive { list-style: none; margin: 0; padding: 0; }
  .archive a {
    display: grid; grid-template-columns: 9rem 1fr 12rem 6rem; gap: 1.2rem;
    align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .archive a:hover .ar-title { color: var(--gold); }
  .ar-date { font-size: 0.8rem; color: var(--ink-mute); letter-spacing: 0.06em; }
  .ar-title { font-family: "Cinzel", Georgia, serif; font-size: 1rem; color: var(--ink); }
  .ar-venue { font-size: 0.92rem; color: var(--ink-soft); font-style: italic; }
  .ar-count { font-size: 0.78rem; color: var(--ink-mute); text-align: right; }

  @media (max-width: 900px) { .why-grid { grid-template-columns: 1fr; } .why-media { max-width: 400px; } }
  @media (max-width: 760px) {
    .band {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 78vw;
      overflow-x: auto; scroll-snap-type: x mandatory;
    }
    .band :global(.photo) { scroll-snap-align: center; }
  }
  @media (max-width: 640px) {
    .playbill { grid-template-columns: 1fr; margin-top: -2rem; }
    .pb-date {
      flex-direction: row; gap: 0.6rem; align-items: baseline;
      border-right: 0; border-bottom: 1px solid var(--rule); padding: 0.9rem 1.2rem;
    }
    .pb-day { font-size: 2rem; }
    .pb-body { padding: 1.4rem 1.2rem 1.5rem; }
    .pb-facts > div { grid-template-columns: 1fr; gap: 0.1rem; }
    .archive a { grid-template-columns: 1fr auto; gap: 0.2rem 1rem; }
    .ar-date { order: 1; } .ar-count { order: 2; text-align: right; }
    .ar-title { order: 3; grid-column: 1 / -1; }
    .ar-venue { order: 4; grid-column: 1 / -1; }
  }
</style>

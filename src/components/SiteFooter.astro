---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <hr class="rule--double" />
    <div class="cols">
      <div>
        <h3>Dice &amp; Tale</h3>
        <p class="small">
          A tabletop roleplaying community in Berlin. Monthly game days, volunteer game
          masters, a table for people who have never played.
        </p>
      </div>
      <div>
        <h3>Come along</h3>
        <ul class="links">
          <li><a href="/game-days">Game days</a></li>
          <li><a href="/join">Discord and mailing list</a></li>
          <li><a href="/gms">Run a table</a></li>
          <li><a href="/code-of-conduct">Code of conduct</a></li>
        </ul>
      </div>
      <div>
        <h3>Booking</h3>
        <p class="small">
          Seats are booked through
          <a href="https://ttrpg.events/diceandtale" rel="noopener">TTRPG.Events</a>,
          which holds the seat counts and waiting lists.
        </p>
        <p class="small">
          <a href="mailto:diceandtale@gmail.com">diceandtale@gmail.com</a>
        </p>
      </div>
    </div>
    <p class="colophon mono">
      &copy; {year} Dice &amp; Tale &middot; Berlin &middot; Set in Cinzel and EB Garamond
    </p>
  </div>
</footer>

<style>
  .site-footer { margin-top: clamp(3rem, 8vw, 6rem); padding-bottom: 3rem; }
  .cols {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem 3rem; padding-top: 2rem;
  }
  h3 { margin-bottom: 0.7rem; color: var(--ink); }
  .small { font-size: 0.94rem; color: var(--ink-soft); max-width: 34ch; margin: 0; }
  .links { list-style: none; margin: 0; padding: 0; font-size: 0.94rem; }
  .links li { margin-bottom: 0.35rem; }
  .links a { color: var(--ink-soft); }
  .colophon {
    margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--rule);
    font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-mute); max-width: none;
  }
</style>
